# Contentful credentials — copy this file to .env and fill in your values.
#
# .env is gitignored; .env.example is the public template that lives in the repo.
# Source the .env file in your shell or sub-process before running commands:
#     set -a; source .env; set +a
# Or for a single command:
#     env $(cat .env | xargs) contentful-pp-cli sync
#
# Personal Access Token for the Content Management API (CMA).
# Create one at https://app.contentful.com/account/profile/cma_tokens
# (or app.eu.contentful.com for EU region).
CONTENTFUL_MANAGEMENT_TOKEN=

# The space ID to operate against. Find it in the URL of your space's web app
# (https://app.contentful.com/spaces/<SPACE_ID>).
CONTENTFUL_SPACE_ID=

# Default environment ID. "master" is the default for most spaces; use a
# disposable test environment for write operations.
CONTENTFUL_ENVIRONMENT_ID=master

# Optional: per-space delivery (CDA) and preview (CPA) tokens for read paths.
# Find them under Settings → API keys in the Contentful web app.
CONTENTFUL_DELIVERY_TOKEN=
CONTENTFUL_PREVIEW_TOKEN=

# Optional: set to "eu" for EU-residency spaces. Flips every base URL to
# *.eu.contentful.com. Default (unset) uses the global edge.
# CONTENTFUL_HOST=eu
